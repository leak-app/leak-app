# Google OAuth 2.0 Client ID (Web application)
# Get from: https://console.cloud.google.com/apis/credentials
# Add http://localhost and http://localhost:5173 to Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=

# Base URL for API (Google App Script Web App URL or backend API)
# Example: https://script.google.com/macros/s/xxx/exec
VITE_BASE_API_URL=http://localhost:3000
